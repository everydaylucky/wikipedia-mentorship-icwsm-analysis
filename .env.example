# Copy this file to .env and fill in the keys. .env is not committed to git.
# The three online M6 services need keys. Every online step (including the Wikipedia API) needs CONTACT_EMAIL.

CONTACT_EMAIL=           # REQUIRED for --online: your own e-mail, sent in the User-Agent (Wikimedia policy)

DEEPSEEK_API_KEY=        # M6 LLM question-type labels (deepseek-v4-flash)
DASHSCOPE_API_KEY=       # M6 Qwen text-embedding-v4 embeddings
PERSPECTIVE_API_KEY=     # M6 Perspective scores
